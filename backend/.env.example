# IrrigaSense Backend Environment Configuration

# Database connection URL (Default: local SQLite database in backend directory)
DATABASE_URL=sqlite:///./irrigasense.db

# Server configuration (Optional)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Session & Security Configuration (Optional - sensible lab defaults provided)
# SESSION_SECRET=your-random-secret-key-here
# SESSION_COOKIE_NAME=irrigasense_session
# SESSION_MAX_AGE_SECONDS=2592000
# SECURE_COOKIES=false
# SESSION_COOKIE_SAMESITE=lax
