# Google Maps JavaScript API Key
# Requires Maps JavaScript API & Places API enabled in Google Cloud Console
# Restrict this key by HTTP referrer (e.g., http://localhost:5173/*, https://your-production-domain.com/*)
VITE_GOOGLE_MAPS_API_KEY=

# Backend API Base URL (Default: http://localhost:8000/api)
VITE_API_URL=http://localhost:8000/api
